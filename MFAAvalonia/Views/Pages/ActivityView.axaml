<UserControl
    d:DesignHeight="900"
    d:DesignWidth="1250"
    mc:Ignorable="d"
    x:Class="MFAAvalonia.Views.Pages.ActivityView"
    x:DataType="pages:ActivityViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fluentIcon="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:MFAAvalonia.ViewModels.Pages"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Design.DataContext>
        <pages:ActivityViewModel />
    </Design.DataContext>

    <UserControl.Resources>
        <DataTemplate x:Key="ActivityCard" x:DataType="pages:ActivityRow">
            <Border Classes="Card"
                    Classes.ended="{Binding IsEnded}"
                    Margin="0,0,0,8"
                    Padding="0"
                    ClipToBounds="True">
                <Grid ColumnDefinitions="4,48,*,124">
                    <!--  3 天内结束：整张卡片铺一层很淡的状态色，红框只做辅助  -->
                    <Border Grid.ColumnSpan="4"
                            Background="{Binding StatusFillBrush}"
                            Opacity="0.35"
                            IsVisible="{Binding IsAlerting}"
                            IsHitTestVisible="False" />

                    <Border Grid.Column="0" Background="{Binding StatusBrush}" />

                    <Border Grid.Column="1"
                            Width="36" Height="36"
                            Margin="10,12,0,12"
                            CornerRadius="9"
                            VerticalAlignment="Top"
                            Background="{Binding StatusFillBrush}">
                        <Panel>
                            <fluentIcon:FluentIcon Icon="Calendar"
                                                   IconSize="Size20"
                                                   Foreground="{Binding StatusBrush}"
                                                   IsVisible="{Binding !IsCommand}" />
                            <fluentIcon:FluentIcon Icon="Book"
                                                   IconSize="Size20"
                                                   Foreground="{Binding StatusBrush}"
                                                   IsVisible="{Binding IsCommand}" />
                        </Panel>
                    </Border>

                    <StackPanel Grid.Column="2" Margin="10,10,10,10" Spacing="1">
                        <TextBlock Classes="ActivityName"
                                   Classes.alert="{Binding IsAlerting}"
                                   Text="{Binding Name}"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />

                        <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,2,0,0">
                            <TextBlock Classes="Hint"
                                       Text="{Binding RangeText}"
                                       VerticalAlignment="Center" />
                            <Border Classes="Tag">
                                <TextBlock Text="{Binding TypeLabel}" />
                            </Border>
                        </StackPanel>

                        <ProgressBar Height="4"
                                     Margin="0,8,0,0"
                                     Minimum="0" Maximum="1"
                                     Value="{Binding ElapsedRatio}"
                                     Background="{DynamicResource SukiPrimaryColor5}"
                                     Foreground="{Binding StatusBrush}" />

                        <Grid ColumnDefinitions="*,Auto" Margin="0,3,0,0">
                            <TextBlock Grid.Column="0" Classes="Hint" Text="{Binding ProgressText}" />
                            <TextBlock Grid.Column="1" Classes="Hint" Text="{Binding EndFootText}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="3"
                                Margin="0,10,14,10"
                                Spacing="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Classes="Hint"
                                   Text="{Binding RemainingLabel}"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding RemainingBigText}"
                                   FontSize="16.5"
                                   FontWeight="Bold"
                                   Foreground="{Binding StatusBrush}"
                                   HorizontalAlignment="Right"
                                   TextAlignment="Right"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal"
                                    Spacing="4"
                                    HorizontalAlignment="Right">
                            <Ellipse Width="4" Height="4"
                                     Fill="{Binding StatusBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatusText}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding StatusBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.Card">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="{DynamicResource SukiCardBackground}" />
        </Style>
        <Style Selector="TextBlock.SectionTitle">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SukiText}" />
        </Style>
        <Style Selector="TextBlock.Hint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource SukiLowText}" />
        </Style>

        <Style Selector="TextBlock.ActivityName">
            <Setter Property="Foreground" Value="{DynamicResource SukiText}" />
        </Style>
        <Style Selector="TextBlock.ActivityName.alert">
            <Setter Property="Foreground" Value="{x:Static pages:ActivityPalette.Alert}" />
        </Style>

        <Style Selector="Border.Tag">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor15}" />
        </Style>
        <Style Selector="Border.Tag TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource SukiLowText}" />
        </Style>

        <Style Selector="Border.Card.ended">
            <Setter Property="Opacity" Value="0.66" />
        </Style>

        <Style Selector="TextBlock.StatLabel">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource SukiLowText}" />
        </Style>
        <Style Selector="TextBlock.StatValue">
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource SukiText}" />
        </Style>
        <Style Selector="TextBlock.StatValue.alert">
            <Setter Property="Foreground" Value="{x:Static pages:ActivityPalette.Alert}" />
        </Style>
        <Style Selector="TextBlock.StatSub">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Foreground" Value="{DynamicResource SukiLowText}" />
        </Style>

        <Style Selector="Border.CountPill">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor15}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Border.ScheduleDate">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="33" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor5}" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="18,14" RowDefinitions="Auto,Auto,Auto,*">

        <!--  ═══ 页头：标题 + 数据新鲜度 + 重新读取  ═══  -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SukiLowText}"
                           Text="作战日历 · BWIKI"
                           LetterSpacing="1.2" />
                <TextBlock Text="活动提醒"
                           FontSize="27"
                           FontWeight="Bold"
                           Foreground="{DynamicResource SukiText}" />
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Ellipse Width="6" Height="6"
                             Fill="{Binding AgeBrush}"
                             VerticalAlignment="Center" />
                    <TextBlock Classes="Hint" Text="{Binding CollectedAtText, StringFormat='采集于 {0}'}" />
                    <TextBlock Classes="Hint" Text="·" />
                    <TextBlock Classes="Hint" Text="{Binding DataAgeText}" />
                    <TextBlock Classes="Hint" Text="·" />
                    <TextBlock Classes="Hint" Text="{Binding SummaryText}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Border Padding="9,3"
                        CornerRadius="999"
                        Background="{DynamicResource SukiPrimaryColor15}"
                        VerticalAlignment="Center">
                    <TextBlock FontSize="10.5"
                               Foreground="{DynamicResource SukiLowText}"
                               Text="自动采集 · 每 6 小时" />
                </Border>
                <Button Classes="Primary" Command="{Binding LoadCommand}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <fluentIcon:FluentIcon Icon="ArrowClockwise" IconSize="Size16" IconVariant="Regular" />
                        <TextBlock Text="重新读取" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!--  ═══ 数据过期提示：>24 小时才出现  ═══  -->
        <Border Grid.Row="1"
                IsVisible="{Binding IsStale}"
                Margin="0,0,0,10"
                Padding="10,8"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{x:Static pages:ActivityPalette.Stale}"
                Background="{x:Static pages:ActivityPalette.StaleFill}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <fluentIcon:FluentIcon Grid.Column="0"
                                       Icon="CalendarClock"
                                       IconSize="Size16"
                                       Foreground="{x:Static pages:ActivityPalette.Stale}"
                                       VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Margin="8,0,12,0"
                           FontSize="11"
                           Foreground="{DynamicResource SukiText}"
                           Text="{Binding StaleText}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <Button Grid.Column="2"
                        Classes="Outlined"
                        Content="重新读取"
                        Command="{Binding LoadCommand}"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!--  ═══ 统计条  ═══  -->
        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,12" ColumnSpacing="8">
            <Border Classes="Card" Padding="11,9" Margin="0,0,8,0">
                <StackPanel Spacing="1">
                    <TextBlock Classes="StatLabel" Text="进行中" />
                    <TextBlock Classes="StatValue" Text="{Binding ActiveCount}" />
                    <TextBlock Classes="StatSub" Text="个活动" />
                </StackPanel>
            </Border>
            <Border Classes="Card" Padding="11,9" Margin="0,0,8,0">
                <StackPanel Spacing="1">
                    <TextBlock Classes="StatLabel" Text="3 天内结束" />
                    <TextBlock Classes="StatValue"
                               Classes.alert="{Binding HasAlerts}"
                               Text="{Binding AlertCount}" />
                    <TextBlock Classes="StatSub" Text="个活动" />
                </StackPanel>
            </Border>
            <Border Classes="Card" Padding="11,9" Margin="0,0,8,0">
                <StackPanel Spacing="1">
                    <TextBlock Classes="StatLabel" Text="下一场结束" />
                    <TextBlock Classes="StatValue" Text="{Binding NextEndDayText}" />
                    <TextBlock Classes="StatSub" Text="{Binding NextEndRelativeText}" />
                </StackPanel>
            </Border>
            <Border Classes="Card" Padding="11,9">
                <StackPanel Spacing="1">
                    <TextBlock Classes="StatLabel" Text="已结束" />
                    <TextBlock Classes="StatValue" Text="{Binding EndedCount}" />
                    <TextBlock Classes="StatSub" Text="个活动" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!--  ═══ 主体：左列表 / 右日程  ═══  -->
        <Grid Grid.Row="3" ColumnDefinitions="1.55*,0.85*" ColumnSpacing="12">

            <ScrollViewer Grid.Column="0" Padding="0,0,4,0">
                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="SectionTitle" Text="进行中" />
                            <Border Classes="CountPill">
                                <TextBlock FontSize="10" Text="{Binding ActiveItems.Count}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="Hint" Text="按结束时间排序" />
                            <TextBlock Classes="Hint"
                                       Foreground="{x:Static pages:ActivityPalette.Alert}"
                                       Text="剩余 &lt; 3 天标红" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding ActiveItems}"
                                  ItemTemplate="{StaticResource ActivityCard}" />

                    <TextBlock Classes="Hint"
                               Margin="0,18,0,0"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="460"
                               IsVisible="{Binding IsEmpty}"
                               Text="{Binding EmptyHint}" />

                    <Expander Margin="0,8,0,0"
                              IsExpanded="False"
                              IsVisible="{Binding HasEnded}">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SukiLowText}"
                                           Text="已结束" />
                                <Border Classes="CountPill">
                                    <TextBlock FontSize="10" Text="{Binding EndedCount}" />
                                </Border>
                            </StackPanel>
                        </Expander.Header>
                        <ItemsControl Margin="0,8,0,0"
                                      ItemsSource="{Binding EndedItems}"
                                      ItemTemplate="{StaticResource ActivityCard}" />
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Column="1" Padding="0,0,0,4">
                <StackPanel Spacing="10">

                    <!--  结束日程  -->
                    <Border Classes="Card" Padding="12">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="SectionTitle" FontSize="13" Text="结束日程" />
                                <TextBlock Grid.Column="1" Classes="Hint" Text="未来 45 天" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding ScheduleItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="pages:ActivityRow">
                                        <Grid ColumnDefinitions="Auto,*,Auto"
                                              ColumnSpacing="8"
                                              Margin="0,3">
                                            <Border Grid.Column="0" Classes="ScheduleDate">
                                                <StackPanel VerticalAlignment="Center" Spacing="0">
                                                    <TextBlock Text="{Binding EndDayText}"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource SukiText}"
                                                               HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding EndWeekdayText}"
                                                               FontSize="8"
                                                               Foreground="{DynamicResource SukiLowText}"
                                                               HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Name}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SukiText}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding RemainingShortText}"
                                                       FontSize="9.5"
                                                       Foreground="{DynamicResource SukiLowText}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!--  提醒规则：沿用现有硬编码口径，先做成说明卡，不在页面里放会骗人的开关  -->
                    <Border Classes="Card" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="SectionTitle" FontSize="13" Text="提醒规则" />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <fluentIcon:FluentIcon Grid.Column="0"
                                                       Icon="CalendarClock"
                                                       IconSize="Size16"
                                                       Foreground="{DynamicResource SukiPrimaryColor}"
                                                       VerticalAlignment="Top"
                                                       Margin="0,1,0,0" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock FontSize="11" Foreground="{DynamicResource SukiText}" Text="开机播报" />
                                    <TextBlock Classes="Hint" Text="3 天内结束的活动，在主页右上角逐条弹出" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <fluentIcon:FluentIcon Grid.Column="0"
                                                       Icon="Calendar"
                                                       IconSize="Size16"
                                                       Foreground="{x:Static pages:ActivityPalette.Alert}"
                                                       VerticalAlignment="Top"
                                                       Margin="0,1,0,0" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock FontSize="11" Foreground="{DynamicResource SukiText}" Text="临期标红" />
                                    <TextBlock Classes="Hint" Text="剩余不足 3 天，整张卡片变红" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!--  数据源  -->
                    <Border Classes="Card" Padding="12">
                        <StackPanel Spacing="7">
                            <TextBlock Classes="SectionTitle" FontSize="13" Text="数据源" />
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Classes="Hint" Text="来源" />
                                <TextBlock Grid.Column="1"
                                           Classes="Hint"
                                           HorizontalAlignment="Right"
                                           Text="{Binding SourceText}"
                                           TextAlignment="Right" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Classes="Hint" Text="自动采集" />
                                <TextBlock Grid.Column="1"
                                           Classes="Hint"
                                           HorizontalAlignment="Right"
                                           Text="启动时 + 每 6 小时" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Classes="Hint" Text="上次采集" />
                                <TextBlock Grid.Column="1"
                                           Classes="Hint"
                                           HorizontalAlignment="Right"
                                           Text="{Binding CollectedAtText}" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Classes="Hint" Text="写入方式" />
                                <TextBlock Grid.Column="1"
                                           Classes="Hint"
                                           HorizontalAlignment="Right"
                                           Text="agent 抓取，页面只读" />
                            </Grid>
                            <TextBlock Classes="Hint"
                                       Text="{Binding StatusText}"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding !IsEmpty}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
