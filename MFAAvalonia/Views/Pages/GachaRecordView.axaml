<UserControl
    d:DesignHeight="900"
    d:DesignWidth="1250"
    mc:Ignorable="d"
    x:Class="MFAAvalonia.Views.Pages.GachaRecordView"
    x:DataType="pages:GachaRecordViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fluentIcon="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:MFAAvalonia.ViewModels.Pages"
    xmlns:shapes="using:Avalonia.Controls.Shapes"
    xmlns:suki="https://github.com/kikipoulet/SukiUI"
    xmlns:conv="clr-namespace:MFAAvalonia.Helper.Converters"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Design.DataContext>
        <pages:GachaRecordViewModel />
    </Design.DataContext>

    <UserControl.Resources>
        <!--  出货抽数 → 欧非三档 / 垫抽水位 → 保底三档，纯 XAML 视觉状态的唯一来源  -->
        <conv:PityToBrushConverter x:Key="PityBrush" />
        <conv:PityProgressBrushConverter x:Key="PityProgressBrush" />
        <conv:RatioToArcGeometryConverter x:Key="PityArc" />
        <conv:ShortTypeLabelConverter x:Key="ShortType" />

        <!--  勋章：外框和抽数胶囊都跟出货抽数走，一只是第几抽出的  -->
        <DataTemplate x:Key="SRankBadge" x:DataType="pages:SRankBadgeItem">
            <Button Classes="BadgeTap"
                    Margin="0,0,7,7"
                    Click="OnBadgeFocusClick"
                    ToolTip.Tip="{Binding TipText}">
                <Panel Width="52" Height="52">
                    <Border CornerRadius="10"
                            ClipToBounds="True"
                            Background="{DynamicResource Gacha.Rarity.Kuang}"
                            IsVisible="{Binding HasAvatar}">
                        <Image Width="52" Height="52"
                               Source="{Binding Avatar}"
                               Stretch="UniformToFill" />
                    </Border>
                    <Border CornerRadius="10"
                            Background="{DynamicResource Gacha.Rarity.Kuang}"
                            IsVisible="{Binding !HasAvatar}">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Text="{Binding Initial}" />
                    </Border>

                    <Border CornerRadius="10"
                            BorderThickness="2"
                            BorderBrush="{Binding PityUsed, Converter={StaticResource PityBrush}}" />

                    <Border Margin="0,2,2,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            CornerRadius="5"
                            Padding="4,0"
                            Background="{DynamicResource Gacha.Status.OffBanner}"
                            IsVisible="{Binding IsOffBanner}">
                        <TextBlock FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Text="歪" />
                    </Border>

                    <Border Classes="BadgePill"
                            Margin="0,0,0,4"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Background="{Binding PityUsed, Converter={StaticResource PityBrush}}">
                        <TextBlock FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Text="{Binding PityText}" />
                    </Border>
                </Panel>
            </Button>
        </DataTemplate>

        <!--  图鉴：按角色去重的一张卡（狂/危/普共用）  -->
        <DataTemplate x:Key="CodexCard" x:DataType="pages:CharacterCodex">
            <Button Classes="CodexTap"
                    Margin="0,0,8,8"
                    Click="OnCodexFocusClick"
                    ToolTip.Tip="{Binding TipText}">
                <Border Width="100"
                        CornerRadius="10"
                        ClipToBounds="True"
                        Background="{DynamicResource SukiCardBackground}">
                    <StackPanel>
                        <Border Height="3" Background="{Binding RarityBrush}" />
                        <StackPanel Margin="8,10,8,8" Spacing="5">
                            <Panel Width="46" Height="46" HorizontalAlignment="Center">
                                <Border CornerRadius="9"
                                        ClipToBounds="True"
                                        Background="{Binding RarityBrush}"
                                        IsVisible="{Binding HasAvatar}">
                                    <Image Width="46" Height="46"
                                           Source="{Binding Avatar}"
                                           Stretch="UniformToFill" />
                                </Border>
                                <Border CornerRadius="9"
                                        Background="{Binding RarityBrush}"
                                        IsVisible="{Binding !HasAvatar}">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="19"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               Text="{Binding Initial}" />
                                </Border>
                                <Border Margin="0,2,2,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        CornerRadius="6"
                                        Padding="5,0"
                                        Background="{Binding RarityBrush}">
                                    <TextBlock FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               Text="{Binding CountBadge}" />
                                </Border>
                                <Border HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        CornerRadius="5"
                                        Padding="4,0"
                                        Background="{DynamicResource Gacha.Status.OffBanner}"
                                        IsVisible="{Binding OffBanner}">
                                    <TextBlock FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               Text="歪" />
                                </Border>
                            </Panel>
                            <TextBlock FontSize="12"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource SukiText}"
                                       Text="{Binding Name}" />
                            <Border CornerRadius="4"
                                    Padding="6,1"
                                    HorizontalAlignment="Center"
                                    Background="{Binding RarityFillBrush}">
                                <TextBlock FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding RarityBrush}"
                                           Text="{Binding ShackleText}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Button>
        </DataTemplate>

        <!--  流水单行：头像 / 名字 / 卡池·时间 / 第几抽  -->
        <DataTemplate x:Key="TimelinePull" x:DataType="pages:GachaPullItem">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  Height="32"
                  ToolTip.Tip="{Binding TipText}">
                <Panel Grid.Column="0"
                       Width="26" Height="26"
                       Margin="0,0,7,0"
                       VerticalAlignment="Center">
                    <Border CornerRadius="6"
                            ClipToBounds="True"
                            Background="{Binding RarityBrush}"
                            IsVisible="{Binding HasAvatar}">
                        <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                    </Border>
                    <Border CornerRadius="6"
                            Background="{Binding RarityBrush}"
                            IsVisible="{Binding !HasAvatar}">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Text="{Binding Initial}" />
                    </Border>
                </Panel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SukiText}"
                                   Text="{Binding Name}"
                                   TextTrimming="CharacterEllipsis" />
                        <Border CornerRadius="3"
                                Padding="4,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Gacha.Status.OffBanner}"
                                IsVisible="{Binding IsOffBanner}">
                            <TextBlock FontSize="8"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Text="歪" />
                        </Border>
                    </StackPanel>
                    <TextBlock FontSize="9"
                               Foreground="{DynamicResource SukiLowText}"
                               Text="{Binding TimelineMetaText}"
                               IsVisible="{Binding ShowTimelineMeta}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Border Grid.Column="2"
                        Classes="BadgePill"
                        MinWidth="44"
                        VerticalAlignment="Center"
                        Background="{Binding PityCount, Converter={StaticResource PityBrush}}">
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Text="{Binding TimelinePityText}" />
                </Border>
            </Grid>
        </DataTemplate>

        <!--  流水分组：同秒多条就是同一发  -->
        <DataTemplate x:Key="TimelineEntryTemplate" x:DataType="pages:TimelineEntry">
            <Border Classes="TimelineBatch"
                    Classes.batch="{Binding IsBatch}"
                    Margin="0,0,0,4"
                    Padding="4"
                    CornerRadius="7">
                <StackPanel Spacing="1">
                    <Grid ColumnDefinitions="Auto,*"
                          IsVisible="{Binding IsBatch}"
                          Margin="2,0,2,3">
                        <Border Grid.Column="0"
                                CornerRadius="4"
                                Padding="5,0"
                                Background="{DynamicResource Gacha.Rarity.Kuang.Fill}">
                            <TextBlock FontSize="8.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Gacha.Rarity.Kuang}"
                                       Text="{Binding BatchLabel}" />
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Margin="6,0,0,0"
                                   FontSize="9"
                                   Foreground="{DynamicResource SukiLowText}"
                                   Text="{Binding HeaderText}"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Items}"
                                  ItemTemplate="{StaticResource TimelinePull}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.Card">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="{DynamicResource SukiCardBackground}" />
        </Style>
        <Style Selector="TextBlock.SectionTitle">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SukiText}" />
        </Style>
        <Style Selector="TextBlock.Hint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource SukiLowText}" />
        </Style>

        <Style Selector="TextBlock.MetricLabel">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource SukiLowText}" />
        </Style>
        <Style Selector="TextBlock.MetricValue">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource SukiText}" />
        </Style>
        <Style Selector="TextBlock.MetricSub">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Foreground" Value="{DynamicResource SukiLowText}" />
        </Style>

        <!--  胶囊行：顶栏筛选用  -->
        <Style Selector="ListBox.Pills ListBoxItem">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor15}" />
            <Setter Property="Foreground" Value="{DynamicResource SukiText}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Background="Transparent"
                                          TextBlock.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBox.Pills ListBoxItem /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.Pills ListBoxItem:selected > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SukiText}" />
        </Style>
        <Style Selector="ListBox.Pills ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor25}" />
        </Style>
        <Style Selector="ListBox.Pills ListBoxItem:selected">
            <Setter Property="Background" Value="#1A0063BB" />
            <Setter Property="Foreground" Value="{DynamicResource SukiText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Gacha.Rarity.Kuang}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <!--  SukiUI 的 ListBoxItem 主题会在选中态往模板 Border 里画实心主色，
              这里把模板层再钉回淡底 + 金色描边，避免顶栏出现一颗刺眼的蓝块。  -->
        <Style Selector="ListBox.Pills ListBoxItem:selected /template/ Border">
            <Setter Property="Background" Value="#1A0063BB" />
            <Setter Property="BorderBrush" Value="{DynamicResource Gacha.Rarity.Kuang}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="ListBox.Pills ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource SukiText}" />
        </Style>

        <!--  流水列表：只要行，不要选中态/悬浮态那套底框  -->
        <Style Selector="ListBox.Timeline ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Background="Transparent" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBox.Timeline ListBoxItem:pointerover /template/ Border">
            <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor15}" />
        </Style>
        <Style Selector="ListBox.Timeline ListBoxItem:selected /template/ Border">
            <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor25}" />
        </Style>

        <Style Selector="Border.TimelineBatch.batch">
            <Setter Property="Background" Value="#12C0915B" />
            <Setter Property="BorderBrush" Value="#33C0915B" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!--  勋章墙与图鉴卡片可点按钮样式：无 chrome 无边距  -->
        <Style Selector="Button.BadgeTap">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Button.BadgeTap:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button.CodexTap">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Button.CodexTap:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button.Link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource SukiLowText}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.Link:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.Link:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Gacha.Rarity.Kuang}" />
        </Style>

        <Style Selector="Border.BadgePill">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="6,1" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="14,10" RowDefinitions="Auto,Auto,*">

        <!--  ═══ Row 0 顶部：标题 + 档案 + 导出 + 更新  ═══  -->
        <suki:GlassCard Grid.Row="0"
                        Margin="0,0,0,10"
                        Padding="14,10"
                        CornerRadius="12"
                        IsAnimated="False">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                    <TextBlock FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SukiLowText}"
                               Text="抽卡记录 · ARCHIVE"
                               LetterSpacing="1.2" />
                    <TextBlock FontSize="25"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SukiText}"
                               Text="MBCC 档案中心" />
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse Width="6" Height="6"
                                 Fill="{Binding FreshnessBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Classes="Hint"
                                   Text="{Binding DataAgeText}"
                                   Foreground="{Binding FreshnessBrush}" />
                        <TextBlock Classes="Hint" Text="·" />
                        <TextBlock Classes="Hint" Text="{Binding LastPullText, StringFormat='最后一抽 {0}'}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Classes="Hint" Text="档案" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding Profiles}"
                              SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                              MinWidth="150"
                              VerticalAlignment="Center"
                              ToolTip.Tip="按 record/抽卡记录/ 下的子目录分档案（一个目录一个账号）">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="pages:ArchiveProfile">
                                <TextBlock Text="{Binding Display}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Classes="Outlined" VerticalAlignment="Center" ToolTip.Tip="导出当前档案：晒卡分享图 / JSON / CSV">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="导出晒卡分享图" Command="{Binding CaptureLongImageCommand}">
                                    <MenuItem.Icon>
                                        <fluentIcon:FluentIcon Icon="Image" IconSize="Size16" IconVariant="Regular" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="导出 JSON 明细" Command="{Binding ExportJsonCommand}">
                                    <MenuItem.Icon>
                                        <fluentIcon:FluentIcon Icon="Document" IconSize="Size16" IconVariant="Regular" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="导出 CSV 表格" Command="{Binding ExportCsvCommand}">
                                    <MenuItem.Icon>
                                        <fluentIcon:FluentIcon Icon="DocumentTable" IconSize="Size16" IconVariant="Regular" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuFlyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <fluentIcon:FluentIcon Icon="ArrowDownload" IconSize="Size16" IconVariant="Regular" />
                            <TextBlock Text="导出" VerticalAlignment="Center" />
                            <fluentIcon:FluentIcon Icon="ChevronDown" IconSize="Size12" IconVariant="Regular" />
                        </StackPanel>
                    </Button>

                    <Button Classes="Primary" Command="{Binding LoadCommand}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <fluentIcon:FluentIcon Icon="ArrowClockwise" IconSize="Size16" IconVariant="Regular" />
                            <TextBlock Text="更新记录" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </suki:GlassCard>

        <!--  ═══ Row 1 工具栏：总览/明细 + 采集状态 + 数据口径  ═══  -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
            <Border Grid.Column="0"
                    Padding="3"
                    CornerRadius="9"
                    Background="{DynamicResource SukiPrimaryColor5}"
                    VerticalAlignment="Center">
                <ListBox Classes="Pills"
                         MinWidth="150"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSection, Mode=TwoWay}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </Border>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="10"
                        Margin="12,0"
                        VerticalAlignment="Center">
                <Border Padding="9,3"
                        CornerRadius="999"
                        Background="{DynamicResource SukiPrimaryColor15}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Ellipse Width="6" Height="6"
                                 Fill="{DynamicResource SukiLowText}"
                                 VerticalAlignment="Center" />
                        <TextBlock FontSize="10.5"
                                   Foreground="{DynamicResource SukiLowText}"
                                   Text="{Binding CollectStatusText}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <TextBlock Classes="Hint" Text="{Binding LastRefreshText}" VerticalAlignment="Center" />
                <TextBlock Classes="Hint"
                           Text="{Binding StatusText}"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="300"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Column="2"
                       Classes="Hint"
                       Text="保底独立计算 · 同秒视为同一发"
                       VerticalAlignment="Center" />
        </Grid>

        <!--  ═══ Row 2 仪表盘  ═══  -->
        <Grid Grid.Row="2" IsVisible="{Binding IsDashboard}">
            <Grid RowDefinitions="Auto,*">

                <!--  欧气横幅：一个结论 + 三个支撑，替代四张等宽 KPI 卡  -->
                <Border Grid.Row="0"
                        Classes="Card"
                        Padding="16"
                        Margin="0,0,0,12"
                        CornerRadius="14"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource Gacha.Hero.Border}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="20">

                        <Grid Grid.Column="0" Width="98" Height="98" VerticalAlignment="Center">
                            <Ellipse Width="92" Height="92"
                                     Stroke="{DynamicResource SukiPrimaryColor5}"
                                     StrokeThickness="8" />
                            <Path Width="92" Height="92"
                                  Stretch="None"
                                  Data="{Binding AvgPityRatio, Converter={StaticResource PityArc}}"
                                  Stroke="{Binding AvgPityValue, Converter={StaticResource PityBrush}}"
                                  StrokeThickness="8"
                                  StrokeLineCap="Round" />
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="1">
                                <TextBlock Text="{Binding AvgPityText}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{Binding AvgPityValue, Converter={StaticResource PityBrush}}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="抽 / 狂"
                                           FontSize="9"
                                           Foreground="{DynamicResource SukiLowText}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <Border HorizontalAlignment="Left"
                                    Padding="6,1"
                                    CornerRadius="4"
                                    Background="{DynamicResource SukiPrimaryColor15}">
                                <TextBlock FontSize="9.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Gacha.Rarity.Kuang}"
                                           Text="档案局欧气评估" />
                            </Border>
                            <TextBlock Text="{Binding LuckGrade}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{Binding AvgPityValue, Converter={StaticResource PityBrush}}" />
                            <TextBlock Classes="Hint"
                                       Text="{Binding HeroSubtitle}"
                                       TextTrimming="CharacterEllipsis" />

                            <Grid Margin="0,6,0,0" MinWidth="220" MaxWidth="300" HorizontalAlignment="Stretch">
                                <ProgressBar Height="5"
                                             Minimum="0" Maximum="1"
                                             Value="{Binding AvgPityRatio}"
                                             Background="{DynamicResource SukiPrimaryColor5}"
                                             Foreground="{Binding AvgPityValue, Converter={StaticResource PityBrush}}" />
                                <Grid ColumnDefinitions="62.5*,37.5*" IsHitTestVisible="False">
                                    <Border Grid.Column="1"
                                            Width="2" Height="9"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource Gacha.Ruler.Tick}" />
                                </Grid>
                            </Grid>
                            <Grid MinWidth="220" MaxWidth="300" HorizontalAlignment="Stretch"
                                  ColumnDefinitions="62.5*,37.5*" Margin="0,3,0,0">
                                <TextBlock Grid.Column="0"
                                           Text="0"
                                           FontSize="9"
                                           Foreground="{DynamicResource SukiLowText}"
                                           HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="0"
                                           Text="50 软保底"
                                           FontSize="9"
                                           Foreground="{DynamicResource SukiLowText}"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,4,0" />
                                <TextBlock Grid.Column="1"
                                           Text="80 必出"
                                           FontSize="9"
                                           Foreground="{DynamicResource SukiLowText}"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>

                        <Grid Grid.Column="2" ColumnDefinitions="*,*,*" ColumnSpacing="14" VerticalAlignment="Center">
                            <StackPanel Grid.Column="0" Spacing="1">
                                <TextBlock Classes="MetricLabel" Text="累计逮捕" />
                                <TextBlock Classes="MetricValue" Text="{Binding TotalPulls}" />
                                <TextBlock Classes="MetricSub" Text="{Binding CrystalCostText}" />
                                <TextBlock Classes="MetricSub" Text="{Binding PoolCountText}" />
                            </StackPanel>

                            <Border Grid.Column="1" BorderThickness="1,0,0,0"
                                    BorderBrush="{DynamicResource SukiBorderBrush}"
                                    Padding="16,0,0,0">
                                <StackPanel Spacing="1">
                                    <TextBlock Classes="MetricLabel" Text="狂厄级总数" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Classes="MetricValue"
                                                   Foreground="{DynamicResource Gacha.Rarity.Kuang}"
                                                   Text="{Binding KuangTotal}" />
                                        <Border Classes="BadgePill"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource SukiPrimaryColor15}">
                                            <TextBlock FontSize="10" Text="{Binding KuangRateText}" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Height="6" Margin="0,6,0,4">
                                        <Border Width="{Binding KuangBarPixels}" Background="{DynamicResource Gacha.Rarity.Kuang}" />
                                        <Border Width="{Binding WeiBarPixels}" Background="{DynamicResource Gacha.Rarity.Wei}" />
                                        <Border Width="{Binding PuBarPixels}" Background="{DynamicResource Gacha.Rarity.Pu}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Ellipse Width="5" Height="5" Fill="{DynamicResource Gacha.Rarity.Kuang}" VerticalAlignment="Center" />
                                            <TextBlock FontSize="9" Text="{Binding KuangTotal, StringFormat='狂 {0}'}" Foreground="{DynamicResource SukiLowText}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Ellipse Width="5" Height="5" Fill="{DynamicResource Gacha.Rarity.Wei}" VerticalAlignment="Center" />
                                            <TextBlock FontSize="9" Text="{Binding WeiTotal, StringFormat='危 {0}'}" Foreground="{DynamicResource SukiLowText}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Ellipse Width="5" Height="5" Fill="{DynamicResource Gacha.Rarity.Pu}" VerticalAlignment="Center" />
                                            <TextBlock FontSize="9" Text="{Binding PuTotal, StringFormat='普 {0}'}" Foreground="{DynamicResource SukiLowText}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" BorderThickness="1,0,0,0"
                                    BorderBrush="{DynamicResource SukiBorderBrush}"
                                    Padding="16,0,0,0">
                                <StackPanel Spacing="1">
                                    <TextBlock Classes="MetricLabel" Text="小保底不歪率" />
                                    <TextBlock Classes="MetricValue" Text="{Binding OffBannerRateText}" />
                                    <ProgressBar Height="5"
                                                 Margin="0,6,0,4"
                                                 Minimum="0" Maximum="100"
                                                 Value="{Binding OffBannerRateValue}"
                                                 Background="{DynamicResource SukiPrimaryColor5}"
                                                 Foreground="{DynamicResource Gacha.Luck.Lucky}" />
                                    <TextBlock Classes="MetricSub"
                                               Text="{Binding OffBannerDetailText}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!--  ═══ 主体双栏：左卡池流 / 右出金记录  ═══  -->
                <Grid Grid.Row="1" ColumnDefinitions="6.2*,3.8*" ColumnSpacing="12">

                    <ScrollViewer Grid.Column="0" Padding="0,0,6,0">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="SectionTitle" Text="追踪档案" />
                                    <TextBlock Classes="Hint" Text="4 类追踪 · 15 个卡池" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Classes="Hint"
                                           Text="最新出金在最前"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding BannerPools}" IsVisible="{Binding !IsEmpty}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="pages:BannerPoolGroup">
                                        <Border Classes="Card" Margin="0,0,0,8">
                                            <StackPanel Spacing="0">

                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                    <Border Grid.Column="0"
                                                            Width="34" Height="34"
                                                            CornerRadius="9"
                                                            VerticalAlignment="Top"
                                                            Background="{Binding AccentFill}">
                                                        <fluentIcon:FluentIcon Icon="{Binding TypeIcon}"
                                                                               IconSize="Size20"
                                                                               IconVariant="Regular"
                                                                               Foreground="{Binding AccentBrush}" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Spacing="2" MinWidth="0">
                                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                                            <TextBlock FontSize="15"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource SukiText}"
                                                                       Text="{Binding PoolName}" />
                                                            <Border Classes="BadgePill"
                                                                    VerticalAlignment="Center"
                                                                    Background="{DynamicResource SukiPrimaryColor15}">
                                                                <TextBlock FontSize="10" Text="{Binding TotalText}" VerticalAlignment="Center" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Classes="Hint"
                                                                   Text="{Binding PoolSubtitle}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="1">
                                                        <TextBlock Text="{Binding PityValueText}"
                                                                   FontSize="19"
                                                                   FontWeight="Bold"
                                                                   Foreground="{Binding CurrentPity, Converter={StaticResource PityBrush}}"
                                                                   HorizontalAlignment="Right" />
                                                        <TextBlock Text="{Binding PityHintText}"
                                                                   FontSize="9.5"
                                                                   Foreground="{DynamicResource SukiLowText}"
                                                                   HorizontalAlignment="Right" />
                                                    </StackPanel>
                                                </Grid>

                                                <Border Margin="0,8,0,0"
                                                        Padding="9,3"
                                                        CornerRadius="6"
                                                        HorizontalAlignment="Left"
                                                        Background="{DynamicResource Gacha.Status.OffBanner}"
                                                        IsVisible="{Binding IsGuaranteedUp}"
                                                        ToolTip.Tip="按本档记录推定：最近一次出狂是常驻角色（歪），所以下一个狂必为当期 UP">
                                                    <TextBlock FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="White"
                                                               Text="{Binding GuaranteeText}" />
                                                </Border>

                                                <Grid Margin="0,10,0,0">
                                                    <ProgressBar Height="8"
                                                                 Minimum="0" Maximum="1"
                                                                 Value="{Binding PityRatio}"
                                                                 Background="{DynamicResource SukiPrimaryColor5}"
                                                                 Foreground="{Binding CurrentPity, Converter={StaticResource PityProgressBrush}}" />
                                                    <Grid ColumnDefinitions="62.5*,37.5*" IsHitTestVisible="False">
                                                        <Border Grid.Column="1"
                                                                Width="2" Height="13"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center"
                                                                Background="{DynamicResource Gacha.Ruler.Tick}"
                                                                ToolTip.Tip="50 抽起进入软保底" />
                                                    </Grid>
                                                </Grid>
                                                <Grid ColumnDefinitions="62.5*,37.5*" Margin="0,3,0,0">
                                                    <TextBlock Grid.Column="0" Text="0"
                                                               FontSize="9"
                                                               Foreground="{DynamicResource SukiLowText}"
                                                               HorizontalAlignment="Left" />
                                                    <TextBlock Grid.Column="0" Text="50 软保底"
                                                               FontSize="9"
                                                               Foreground="{DynamicResource SukiLowText}"
                                                               HorizontalAlignment="Right"
                                                               Margin="0,0,4,0" />
                                                    <TextBlock Grid.Column="1" Text="80 必出"
                                                               FontSize="9"
                                                               Foreground="{DynamicResource SukiLowText}"
                                                               HorizontalAlignment="Right" />
                                                </Grid>

                                                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,9,0,5">
                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock FontSize="11"
                                                                   Foreground="{DynamicResource SukiLowText}"
                                                                   Text="狂厄级" />
                                                        <TextBlock FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Gacha.Rarity.Kuang}"
                                                                   Text="{Binding SRankCount}" />
                                                        <TextBlock FontSize="11"
                                                                   Foreground="{DynamicResource SukiLowText}"
                                                                   Text="次" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                               Classes="Hint"
                                                               Text="{Binding LatestText}"
                                                               Margin="0,0,8,0"
                                                               VerticalAlignment="Center" />
                                                    <Button Grid.Column="2"
                                                            Classes="Link"
                                                            Content="{Binding ExpandText}"
                                                            IsVisible="{Binding CanExpand}"
                                                            Click="OnPoolExpandClick"
                                                            VerticalAlignment="Center" />
                                                </Grid>

                                                <ItemsControl ItemsSource="{Binding DisplayBadges}"
                                                              ItemTemplate="{StaticResource SRankBadge}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Classes="Hint"
                                       Margin="0,30,0,0"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       MaxWidth="460"
                                       IsVisible="{Binding IsEmpty}"
                                       Text="{Binding StatusText}" />

                            <!--  ═══ 禁闭者图鉴（按角色去重，默认收起）═══  -->
                            <Expander Margin="0,4,0,0"
                                      IsExpanded="False"
                                      IsVisible="{Binding HasCodex}"
                                      Header="{Binding CodexHeaderText}">
                                <StackPanel Margin="0,8,0,0" Spacing="12">
                                    <StackPanel Spacing="6" IsVisible="{Binding HasCodexKuang}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Width="4" Height="16" CornerRadius="2"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource Gacha.Rarity.Kuang}" />
                                            <TextBlock FontSize="14" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Gacha.Rarity.Kuang}"
                                                       Text="狂级" />
                                            <TextBlock Classes="Hint"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding CodexTopKuangName, StringFormat='获取最多：{0}'}" />
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding CodexKuang}"
                                                      ItemTemplate="{StaticResource CodexCard}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Spacing="6" IsVisible="{Binding HasCodexWei}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Width="4" Height="16" CornerRadius="2"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource Gacha.Rarity.Wei}" />
                                            <TextBlock FontSize="14" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Gacha.Rarity.Wei}"
                                                       Text="危级" />
                                            <TextBlock Classes="Hint"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding CodexTopWeiName, StringFormat='获取最多：{0}'}" />
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding CodexWei}"
                                                      ItemTemplate="{StaticResource CodexCard}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Spacing="6" IsVisible="{Binding HasCodexPu}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Width="4" Height="16" CornerRadius="2"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource Gacha.Rarity.Pu}" />
                                            <TextBlock FontSize="14" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Gacha.Rarity.Pu}"
                                                       Text="普级" />
                                            <TextBlock Classes="Hint"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding CodexTopPuName, StringFormat='获取最多：{0}'}" />
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding CodexPu}"
                                                      ItemTemplate="{StaticResource CodexCard}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>

                            <Border Classes="Card" Padding="12" Margin="0,4,0,0">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="Hint" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Classes="Hint"
                                               Text="本页只读 record/抽卡记录/*.jsonl；采集由任务或启动时完成" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!--  ═══ 右栏：出金记录  ═══  -->
                    <Border Grid.Column="1" Classes="Card" Padding="12">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="7">

                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <TextBlock Classes="SectionTitle" Text="出金记录" />
                                    <Border Classes="BadgePill"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource SukiPrimaryColor15}">
                                        <TextBlock FontSize="10" Text="{Binding TimelineCountText}" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Classes="Hint"
                                           Text="同秒多条 = 同一发"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <Border Grid.Row="1"
                                    Padding="9"
                                    CornerRadius="8"
                                    Background="{DynamicResource SukiPrimaryColor5}">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="近 12 次出金"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SukiText}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="每根 = 耗费抽数"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource SukiLowText}" />
                                    </Grid>

                                    <Grid Height="52">
                                        <Border Height="1"
                                                VerticalAlignment="Bottom"
                                                Margin="0,0,0,32"
                                                Background="{DynamicResource Gacha.Ruler.Tick}"
                                                Opacity="0.5" />
                                        <ItemsControl ItemsSource="{Binding RecentPityBars}"
                                                      VerticalAlignment="Bottom">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="pages:PityBar">
                                                    <Border Width="14"
                                                            Height="{Binding Height}"
                                                            Background="{Binding Brush}"
                                                            CornerRadius="3,3,0,0"
                                                            ToolTip.Tip="{Binding TipText}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Ellipse Width="4" Height="4" Fill="{DynamicResource Gacha.Luck.Lucky}" VerticalAlignment="Center" />
                                            <TextBlock FontSize="8.5" Text="≤30 欧" Foreground="{DynamicResource SukiLowText}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Ellipse Width="4" Height="4" Fill="{DynamicResource Gacha.Luck.Normal}" VerticalAlignment="Center" />
                                            <TextBlock FontSize="8.5" Text="31–55 正常" Foreground="{DynamicResource SukiLowText}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Ellipse Width="4" Height="4" Fill="{DynamicResource Gacha.Luck.Hard}" VerticalAlignment="Center" />
                                            <TextBlock FontSize="8.5" Text="&gt;55 保底" Foreground="{DynamicResource SukiLowText}" />
                                        </StackPanel>
                                        <TextBlock FontSize="8.5"
                                                   Text="虚线 = 50 抽"
                                                   Foreground="{DynamicResource SukiLowText}"
                                                   Margin="0,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <ListBox Grid.Row="2"
                                     Classes="Pills"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemsSource="{Binding TimelineTypeFilters}"
                                     SelectedItem="{Binding SelectedTimelineTypeFilter, Mode=TwoWay}"
                                     ToolTip.Tip="只看某个追踪类型的出金；点勋章墙上的头像也会同步到这里">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource ShortType}}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBox Grid.Row="3"
                                     Watermark="搜索 角色名 / 卡池"
                                     Text="{Binding TimelineSearch}" />

                            <ListBox Grid.Row="4"
                                     Classes="Timeline"
                                     ItemsSource="{Binding TimelineEntries}"
                                     ItemTemplate="{StaticResource TimelineEntryTemplate}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                            <TextBlock Grid.Row="5"
                                       FontSize="9"
                                       Foreground="{DynamicResource SukiLowText}"
                                       HorizontalAlignment="Center"
                                       Text="流水只列狂级 · 同秒多条合并为同一发" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!--  ═══ Row 2 明细表  ═══  -->
        <Grid Grid.Row="2" IsVisible="{Binding IsTableView}">
            <Grid RowDefinitions="Auto,*,Auto" Margin="4,8,4,4">
                <Border Grid.Row="0" Classes="Card" Padding="12,8" Margin="0,0,0,10">
                    <WrapPanel Orientation="Horizontal">
                        <TextBlock Classes="Hint" Text="稀有度" Margin="0,0,6,8" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding RarityFilters}" SelectedItem="{Binding SelectedRarity}"
                                  MinWidth="84" Margin="0,0,14,8" />
                        <TextBlock Classes="Hint" Text="文件来源" Margin="0,0,6,8" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding SourceFilters}" SelectedItem="{Binding SelectedSource}"
                                  MinWidth="180" Margin="0,0,14,8" />
                        <TextBlock Classes="Hint" Text="排序" Margin="0,0,6,8" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding SortFields}" SelectedItem="{Binding SelectedSortField}"
                                  MinWidth="96" Margin="0,0,6,8" />
                        <ToggleButton IsChecked="{Binding SortDescending}" Content="降序" MinWidth="54" Margin="0,0,14,8" />
                        <TextBox Text="{Binding TableSearch}" Watermark="搜索 禁闭者名 / 卡池" MinWidth="180" Margin="0,0,10,8" />
                        <Button Command="{Binding ResetTableFiltersCommand}" Content="重置筛选" Margin="0,0,0,8" />
                    </WrapPanel>
                </Border>

                <Border Grid.Row="1" CornerRadius="10" ClipToBounds="True" BorderThickness="1"
                        BorderBrush="{DynamicResource SukiBorderBrush}"
                        Background="{DynamicResource SukiCardBackground}">
                    <Grid>
                        <DataGrid ItemsSource="{Binding Records}"
                                  x:CompileBindings="False"
                                  IsVisible="{Binding !IsEmpty}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserSortColumns="False" CanUserReorderColumns="False" CanUserResizeColumns="True"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" SelectionMode="Single">
                            <DataGrid.Styles>
                                <Style Selector="DataGridRow">
                                    <Setter Property="Background" Value="{Binding RowFill}" />
                                </Style>
                                <Style Selector="DataGridRow:nth-child(even)">
                                    <Setter Property="Background" Value="{Binding RowFill}" />
                                </Style>
                                <Style Selector="DataGridCell">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="10,6" />
                                    <Setter Property="FontSize" Value="13" />
                                    <Setter Property="Foreground" Value="{DynamicResource SukiText}" />
                                </Style>
                                <Style Selector="DataGridColumnHeader">
                                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="12,9" />
                                    <Setter Property="FontSize" Value="13" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Background" Value="{DynamicResource Gacha.Table.HeaderBackground}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Gacha.Table.HeaderForeground}" />
                                    <Setter Property="Template">
                                        <ControlTemplate>
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{DynamicResource Gacha.Table.HeaderBorder}" BorderThickness="0,0,1,0"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                  TextBlock.Foreground="{TemplateBinding Foreground}" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter>
                                </Style>
                            </DataGrid.Styles>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="卡池" Width="1.4*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="Auto,Auto,*">
                                                <Border Grid.Column="0" Width="4" Height="20" CornerRadius="2"
                                                        Background="{Binding RarityBrush}" Margin="0,0,8,0"
                                                        VerticalAlignment="Center" />
                                                <Border Grid.Column="1" Classes="Tag" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding TypeShortLabel}" />
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{Binding Pool}"
                                                           Foreground="{DynamicResource SukiText}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="稀有度" Width="96">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="6" Padding="10,2" HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding RarityBadgeFill}">
                                                <TextBlock Text="{Binding Rarity}" FontWeight="Bold" FontSize="12"
                                                           Foreground="{Binding RarityBrush}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="禁闭者" Width="1.3*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="Auto,*">
                                                <Panel Grid.Column="0" Width="24" Height="24" Margin="0,0,8,0"
                                                       VerticalAlignment="Center">
                                                    <Border CornerRadius="12" ClipToBounds="True"
                                                            Background="{Binding RarityBrush}"
                                                            IsVisible="{Binding HasAvatar}">
                                                        <Image Source="{Binding Avatar}" Stretch="UniformToFill"
                                                               Width="24" Height="24" />
                                                    </Border>
                                                    <Border CornerRadius="12" Background="{Binding RarityBrush}"
                                                            IsVisible="{Binding !HasAvatar}">
                                                        <TextBlock Text="{Binding Initial}" FontSize="11"
                                                                   FontWeight="Bold" Foreground="White"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                </Panel>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                           Foreground="{DynamicResource SukiText}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="时间" Width="185">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Time}"
                                                       Foreground="{DynamicResource SukiLowText}"
                                                       VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="{Binding StatusText}" IsVisible="{Binding IsEmpty}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SukiLowText}" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Classes="Card" Padding="12,6" Margin="0,10,0,0"
                        IsVisible="{Binding !IsEmpty}">
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <Button Command="{Binding FirstPageCommand}" Content="⏮" IsEnabled="{Binding CanPrev}"
                                MinWidth="34" Padding="6,2" />
                        <Button Command="{Binding PrevPageCommand}" Content="上一页" IsEnabled="{Binding CanPrev}" />
                        <TextBlock Text="{Binding PageText}" VerticalAlignment="Center" MinWidth="96"
                                   TextAlignment="Center" Foreground="{DynamicResource SukiText}" />
                        <Button Command="{Binding NextPageCommand}" Content="下一页" IsEnabled="{Binding CanNext}" />
                        <Button Command="{Binding LastPageCommand}" Content="⏭" IsEnabled="{Binding CanNext}"
                                MinWidth="34" Padding="6,2" />
                        <TextBlock Text="每页" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Foreground="{DynamicResource SukiLowText}" />
                        <ComboBox ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize}"
                                  MinWidth="66" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TableCount, StringFormat='共 {0} 条'}" VerticalAlignment="Center"
                                   Margin="8,0,0,0" Foreground="{DynamicResource SukiLowText}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!--  晒卡分享卡的渲染宿主：0 尺寸 + 裁剪，正常排版时完全看不见。  -->
        <Border x:Name="ShareCardHost"
                Grid.Row="0"
                Grid.RowSpan="3"
                Width="0"
                Height="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                ClipToBounds="True"
                IsHitTestVisible="False" />
    </Grid>
</UserControl>
