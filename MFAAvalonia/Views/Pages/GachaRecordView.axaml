<UserControl
    d:DesignHeight="760"
    d:DesignWidth="1120"
    mc:Ignorable="d"
    x:Class="MFAAvalonia.Views.Pages.GachaRecordView"
    x:DataType="pages:GachaRecordViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:MFAAvalonia.ViewModels.Pages"
    xmlns:fluentIcon="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Design.DataContext>
        <pages:GachaRecordViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="Border.Card">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="{DynamicResource SukiCardBackground}" />
        </Style>
        <Style Selector="TextBlock.StatValue">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource SukiText}" />
        </Style>
        <Style Selector="TextBlock.StatLabel">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SukiLowText}" />
        </Style>
        <Style Selector="TextBlock.SectionTitle">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SukiText}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource SukiLowText}" />
        </Style>

        <!--  卡池类型胶囊：参考鸣潮助手抽卡分析页的顶部胶囊行，替代原左侧卡池栏。
              模板里的 ContentPresenter 必须强制透明并占用 PART_ContentPresenter 名字：
              主题（Fluent/SukiUI）会在选中态往内容层画深色底框，不压掉就会在胶囊里露出一个方形色块。  -->
        <Style Selector="ListBox.PoolPills ListBoxItem">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor15}" />
            <Setter Property="Foreground" Value="{DynamicResource SukiText}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Background="Transparent"
                                          TextBlock.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBox.PoolPills ListBoxItem /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.PoolPills ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor25}" />
        </Style>
        <Style Selector="ListBox.PoolPills ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource SukiPrimaryColor}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="16" RowDefinitions="Auto,*">

        <!--  顶部卡池切换：横排胶囊。卡池选择移到顶部后，
              横向空间全部还给内容区（原来是左侧 210 栏 + 右侧三页签抢宽度）。
              右侧固定放「更新记录」：重读 record/ 下的 jsonl 并刷新本页，三个页签下都能点到。  -->
        <Border Grid.Row="0" Classes="Card" Margin="0,0,0,12" Padding="10,8,10,2">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" Classes="SectionTitle" Text="追踪类型"
                           Margin="4,0,12,6" VerticalAlignment="Center" />
                <ListBox Grid.Column="1" Classes="PoolPills"
                         ItemsSource="{Binding Pools}"
                         SelectedItem="{Binding SelectedPoolItem, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="pages:PoolItem">
                            <!--  抽数跟在池名后面、用同一前景色的低透明度，
                                  这样选中（实心底）时颜色跟着走，不用单独给徽章配色。  -->
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="200" />
                                <TextBlock Text="{Binding Count}" FontSize="11" Opacity="0.7"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10"
                            Margin="12,0,4,6" VerticalAlignment="Center">
                    <TextBlock Classes="StatLabel" Text="{Binding LastRefreshText}" VerticalAlignment="Center" />
                    <Button Content="更新记录" Command="{Binding LoadCommand}"
                            ToolTip.Tip="重新读取 record/ 下的抽卡记录并刷新本页（采集新记录请运行「抽卡记录」任务）" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 三页签 -->
        <TabControl Grid.Row="1" Padding="0">
            <TabItem Header="概览">
                <ScrollViewer Padding="4,8">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="SectionTitle" Text="稀有度分布" Margin="0" VerticalAlignment="Center" />
                            <TextBlock Classes="StatLabel" Text="{Binding ScopeLabel}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- 占比条 -->
                        <Border Classes="Card">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="36,*,Auto">
                                    <TextBlock Grid.Column="0" Text="狂" FontWeight="Bold" Foreground="{DynamicResource Gacha.Rarity.Kuang}" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Height="12"
                                                 Foreground="{DynamicResource Gacha.Rarity.Kuang}" Background="{DynamicResource SukiPrimaryColor5}"
                                                 Value="{Binding KuangRatio}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding KuangCount}" FontWeight="Bold" />
                                        <TextBlock Text="{Binding KuangPctText}" Foreground="{DynamicResource SukiLowText}" />
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="36,*,Auto">
                                    <TextBlock Grid.Column="0" Text="危" FontWeight="Bold" Foreground="{DynamicResource Gacha.Rarity.Wei}" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Height="12"
                                                 Foreground="{DynamicResource Gacha.Rarity.Wei}" Background="{DynamicResource SukiPrimaryColor5}"
                                                 Value="{Binding WeiRatio}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding WeiCount}" FontWeight="Bold" />
                                        <TextBlock Text="{Binding WeiPctText}" Foreground="{DynamicResource SukiLowText}" />
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="36,*,Auto">
                                    <TextBlock Grid.Column="0" Text="普" FontWeight="Bold" Foreground="{DynamicResource Gacha.Rarity.Pu}" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Height="12"
                                                 Foreground="{DynamicResource Gacha.Rarity.Pu}" Background="{DynamicResource SukiPrimaryColor5}"
                                                 Value="{Binding PuRatio}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PuCount}" FontWeight="Bold" />
                                        <TextBlock Text="{Binding PuPctText}" Foreground="{DynamicResource SukiLowText}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 关键指标 -->
                        <WrapPanel>
                            <Border Classes="Card" MinWidth="130" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Classes="StatLabel" Text="总抽数" />
                                    <TextBlock Classes="StatValue" Text="{Binding DisplayCount}" />
                                </StackPanel>
                            </Border>
                            <Border Classes="Card" MinWidth="130" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Classes="StatLabel" Text="平均出货抽数(狂)" />
                                    <TextBlock Classes="StatValue" Text="{Binding AvgPerKuangText}" />
                                </StackPanel>
                            </Border>
                            <Border Classes="Card" MinWidth="120" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Classes="StatLabel" Text="最欧(最少抽出金)" />
                                    <TextBlock Classes="StatValue" Text="{Binding LuckiestText}"
                                               Foreground="{DynamicResource SukiSuccessColor}" />
                                </StackPanel>
                            </Border>
                            <Border Classes="Card" MinWidth="120" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Classes="StatLabel" Text="最非(最多抽出金)" />
                                    <TextBlock Classes="StatValue" Text="{Binding UnluckiestText}"
                                               Foreground="{DynamicResource SukiDangerColor}" />
                                </StackPanel>
                            </Border>
                            <Border Classes="Card" MinWidth="120" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Classes="StatLabel" Text="距上次狂" />
                                    <TextBlock Classes="StatValue" Text="{Binding PitySinceKuang}" Foreground="{DynamicResource Gacha.Rarity.Kuang}" />
                                </StackPanel>
                            </Border>
                            <Border Classes="Card" MinWidth="120" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Classes="StatLabel" Text="距上次危" />
                                    <TextBlock Classes="StatValue" Text="{Binding PitySinceWei}" Foreground="{DynamicResource Gacha.Rarity.Wei}" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <!-- 保底状态：按活动追踪规则显示。规则 1=每 10 抽必出危或狂；规则 2=50 抽后概率递增、80 抽硬保底。
                             计数按追踪类型独立（规则 4），所以顶栏选了具体卡池时，这里的数字就是那个卡池的。 -->
                        <Border Classes="Card">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Classes="SectionTitle" Text="保底状态" Margin="0" />
                                    <TextBlock Classes="StatLabel" Text="{Binding PityScopeText}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding PityStatusText}"
                                           Foreground="{DynamicResource Gacha.Rarity.Kuang}" />
                                <TextBlock Classes="StatLabel" Text="{Binding SoftPityStatusText}" />
                            </StackPanel>
                        </Border>

                        <!-- 狂级出金记录：距上一个狂第几抽出金（含自身），头像+名字+来源标签+相对长度条。
                             来源标签 = 该条记录所属追踪类型的短名（活动/统合/定向/常驻/限定），与顶部胶囊一一对应。
                             按出金时间倒序排（最新在最前）；时间不写在卡片上（挤在头像边上难看），悬停看 ToolTip。 -->
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Classes="SectionTitle" Text="狂级出金记录" Margin="0,0,0,8" />
                            <TextBlock Classes="StatLabel" Text="{Binding GoldPoolSplitText}"
                                       VerticalAlignment="Center" Margin="0,0,0,8" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding GoldPulls}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="pages:GoldPull">
                                    <Border Margin="0,0,8,8" CornerRadius="8" Padding="8,6"
                                            Background="{DynamicResource SukiCardBackground}"
                                            ToolTip.Tip="{Binding Time}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Panel Width="34" Height="34">
                                                <Border CornerRadius="17" ClipToBounds="True" Background="{DynamicResource Gacha.Rarity.Kuang}"
                                                        IsVisible="{Binding HasAvatar}">
                                                    <Image Source="{Binding Avatar}" Stretch="UniformToFill" Width="34" Height="34" />
                                                </Border>
                                                <Border CornerRadius="17" Background="{DynamicResource Gacha.Rarity.Kuang}"
                                                        IsVisible="{Binding !HasAvatar}">
                                                    <TextBlock Text="{Binding Initial}" FontSize="16" FontWeight="Bold"
                                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Panel>
                                            <StackPanel MinWidth="110" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Gacha.Rarity.Kuang}" />
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Display}" FontSize="11"
                                                               Foreground="{DynamicResource SukiLowText}" />
                                                    <!--  来源标签与该条记录所属的追踪类型一一对应（活动/统合/定向/常驻/限定），
                                                          与顶部胶囊同名；限定仍金色高亮，其余低亮。  -->
                                                    <TextBlock Text="{Binding SourceLabel}" FontSize="11" FontWeight="SemiBold"
                                                               IsVisible="{Binding IsLimited}"
                                                               Foreground="{DynamicResource Gacha.Rarity.Kuang}" />
                                                    <TextBlock Text="{Binding SourceLabel}" FontSize="11"
                                                               IsVisible="{Binding !IsLimited}"
                                                               Foreground="{DynamicResource SukiLowText}" />
                                                </StackPanel>
                                                <!--  长度按规则 2 的 80 抽硬保底取：条满即硬吃保底  -->
                                                <ProgressBar Margin="0,3,0,0" Height="6"
                                                             Minimum="0" Maximum="1"
                                                             Value="{Binding Ratio}"
                                                             Foreground="{DynamicResource Gacha.Rarity.Kuang}"
                                                             Background="{DynamicResource SukiPrimaryColor5}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="表格">
                <Grid RowDefinitions="Auto,*,Auto" Margin="4,8,4,4">
                    <Border Grid.Row="0" Classes="Card" Padding="12,8" Margin="0,0,0,10">
                        <WrapPanel Orientation="Horizontal">
                            <Button Command="{Binding LoadCommand}" Content="刷新" Margin="0,0,8,8" />
                            <Button Command="{Binding ResetFiltersCommand}" Content="重置" Margin="0,0,16,8" />
                            <TextBlock Classes="FieldLabel" Text="稀有度" Margin="0,0,4,8" />
                            <ComboBox ItemsSource="{Binding RarityFilters}" SelectedItem="{Binding SelectedRarity}"
                                      MinWidth="82" Margin="0,0,14,8" />
                            <TextBlock Classes="FieldLabel" Text="来源" Margin="0,0,4,8" />
                            <ComboBox ItemsSource="{Binding SourceFilters}" SelectedItem="{Binding SelectedSource}"
                                      MinWidth="180" Margin="0,0,14,8" />
                            <TextBlock Classes="FieldLabel" Text="排序" Margin="0,0,4,8" />
                            <ComboBox ItemsSource="{Binding SortFields}" SelectedItem="{Binding SelectedSortField}"
                                      MinWidth="96" Margin="0,0,4,8" />
                            <ToggleButton IsChecked="{Binding SortDescending}" Content="降序" MinWidth="52" Margin="0,0,14,8" />
                            <TextBox Text="{Binding SearchText}" Watermark="搜索 角色名 / 卡池" MinWidth="170" Margin="0,0,0,8" />
                        </WrapPanel>
                    </Border>

                    <Border Grid.Row="1" CornerRadius="10" ClipToBounds="True" BorderThickness="1"
                            BorderBrush="{DynamicResource SukiBorderBrush}">
                        <Panel>
                            <DataGrid ItemsSource="{Binding Records}"
                                      x:CompileBindings="False"
                                      IsVisible="{Binding !IsEmpty}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserSortColumns="False" CanUserReorderColumns="False" CanUserResizeColumns="True"
                                      GridLinesVisibility="All" HeadersVisibility="Column" SelectionMode="Single">
                                <DataGrid.Styles>
                                    <Style Selector="DataGridRow">
                                        <Setter Property="Background" Value="{Binding RowTint}" />
                                    </Style>
                                    <Style Selector="DataGridRow:nth-child(even)">
                                        <Setter Property="Background" Value="{Binding RowTint}" />
                                    </Style>
                                    <Style Selector="DataGridCell">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                        <Setter Property="Padding" Value="10,5" />
                                        <Setter Property="FontSize" Value="13" />
                                        <Setter Property="Foreground" Value="Black" />
                                    </Style>
                                    <Style Selector="DataGridColumnHeader">
                                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                        <Setter Property="Padding" Value="12,9" />
                                        <Setter Property="FontSize" Value="13" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Background" Value="{DynamicResource Gacha.Table.HeaderBackground}" />
                                        <Setter Property="Foreground" Value="{DynamicResource Gacha.Table.HeaderForeground}" />
                                        <Setter Property="Template">
                                            <ControlTemplate>
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{DynamicResource Gacha.Table.HeaderBorder}" BorderThickness="0,0,1,0"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                      TextBlock.Foreground="{TemplateBinding Foreground}" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter>
                                    </Style>
                                </DataGrid.Styles>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="卡池" Width="1.3*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Pool}" Foreground="{DynamicResource Gacha.Table.CellForeground}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Left" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="稀有度" Binding="{Binding Rarity}" Width="100" />
                                    <DataGridTextColumn Header="角色名" Binding="{Binding Name}" Width="1.3*" />
                                    <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="185" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="{Binding StatusText}" IsVisible="{Binding IsEmpty}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SukiLowText}" />
                        </Panel>
                    </Border>

                    <!-- 分页条 -->
                    <Border Grid.Row="2" Classes="Card" Padding="12,6" Margin="0,10,0,0"
                            IsVisible="{Binding !IsEmpty}">
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <Button Command="{Binding FirstPageCommand}" Content="⏮" IsEnabled="{Binding CanPrev}"
                                    MinWidth="34" Padding="6,2" />
                            <Button Command="{Binding PrevPageCommand}" Content="上一页" IsEnabled="{Binding CanPrev}" />
                            <TextBlock Text="{Binding PageText}" VerticalAlignment="Center" MinWidth="96" TextAlignment="Center"
                                       Foreground="{DynamicResource SukiText}" />
                            <Button Command="{Binding NextPageCommand}" Content="下一页" IsEnabled="{Binding CanNext}" />
                            <Button Command="{Binding LastPageCommand}" Content="⏭" IsEnabled="{Binding CanNext}"
                                    MinWidth="34" Padding="6,2" />
                            <TextBlock Text="每页" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Foreground="{DynamicResource SukiLowText}" />
                            <ComboBox ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize}"
                                      MinWidth="66" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DisplayCount, StringFormat='共 {0} 条'}" VerticalAlignment="Center"
                                       Margin="8,0,0,0" Foreground="{DynamicResource SukiLowText}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="统计">
                <ScrollViewer Padding="4,8">
                    <StackPanel Spacing="14">
                        <!-- 顶部汇总卡 -->
                        <WrapPanel>
                            <Border Classes="Card" MinWidth="150" Margin="0,0,12,12">
                                <StackPanel>
                                    <TextBlock Classes="StatLabel" Text="总抽数" />
                                    <TextBlock Classes="StatValue" Text="{Binding DisplayCount}" />
                                    <TextBlock Classes="StatLabel" Text="{Binding StatusText}" Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                </StackPanel>
                            </Border>
                            <Border Classes="Card" MinWidth="150" Margin="0,0,12,12">
                                <StackPanel>
                                    <TextBlock Classes="StatLabel" Text="狂" />
                                    <TextBlock Classes="StatValue" Text="{Binding KuangCount}" Foreground="{DynamicResource Gacha.Rarity.Kuang}" />
                                    <TextBlock Classes="StatLabel" Text="{Binding TopKuangName, StringFormat='最多：{0}'}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                </StackPanel>
                            </Border>
                            <Border Classes="Card" MinWidth="150" Margin="0,0,12,12">
                                <StackPanel>
                                    <TextBlock Classes="StatLabel" Text="危" />
                                    <TextBlock Classes="StatValue" Text="{Binding WeiCount}" Foreground="{DynamicResource Gacha.Rarity.Wei}" />
                                    <TextBlock Classes="StatLabel" Text="{Binding TopWeiName, StringFormat='最多：{0}'}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                </StackPanel>
                            </Border>
                            <Border Classes="Card" MinWidth="150" Margin="0,0,12,12">
                                <StackPanel>
                                    <TextBlock Classes="StatLabel" Text="普" />
                                    <TextBlock Classes="StatValue" Text="{Binding PuCount}" Foreground="{DynamicResource Gacha.Rarity.Pu}" />
                                    <TextBlock Classes="StatLabel" Text="{Binding TopPuName, StringFormat='最多：{0}'}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <!-- 角色获得次数卡片墙（按 狂→危→普 排列） -->
                        <TextBlock Classes="SectionTitle" Text="角色获得次数（狂 → 危 → 普）" />
                        <ItemsControl ItemsSource="{Binding CharacterStats}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="pages:CharacterStat">
                                    <Border Width="96" Margin="0,0,10,10" CornerRadius="10" Padding="8,10"
                                            Background="{DynamicResource SukiCardBackground}">
                                        <StackPanel Spacing="6">
                                            <Panel Width="42" Height="42" HorizontalAlignment="Center">
                                                <Border CornerRadius="9" ClipToBounds="True" Background="{Binding RarityBrush}"
                                                        IsVisible="{Binding HasAvatar}">
                                                    <Image Source="{Binding Avatar}" Stretch="UniformToFill" Width="42" Height="42" />
                                                </Border>
                                                <Border CornerRadius="9" Background="{Binding RarityBrush}"
                                                        IsVisible="{Binding !HasAvatar}">
                                                    <TextBlock Text="{Binding Initial}" FontSize="20" FontWeight="Bold"
                                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Panel>
                                            <TextBlock Text="{Binding Name}" FontSize="12" TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SukiText}" />
                                            <TextBlock Text="{Binding Count}" FontWeight="Bold" FontSize="15" TextAlignment="Center"
                                                       Foreground="{DynamicResource SukiLowText}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
